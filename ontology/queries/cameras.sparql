PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ssn: <http://www.w3.org/ns/ssn/>
PREFIX ssn-system: <http://www.w3.org/ns/ssn/systems/>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX mm: <http://www.semanticweb.org/efliao/ontologies/2026/10/mm-ontology/>

# Every camera: its device and socket, autofocus, sensor specs, max frame rate, horizontal FOV, and stereo partner.
SELECT ?device ?socket ?camera ?sensor ?autofocus ?width ?height ?shutter ?fps ?hfovDeg ?stereoPartner
WHERE {
  ?camera a mm:Camera .

  OPTIONAL { ?device ssn:hasSubSystem ?camera . }
  OPTIONAL { ?camera mm:boardSocket ?socket . }
  OPTIONAL { ?camera mm:hasAutofocus ?autofocus . }
  OPTIONAL {
    ?camera mm:sensorModel ?model .

    ?model rdfs:label ?sensor .

    OPTIONAL { ?model mm:sensorWidth ?width . }
    OPTIONAL { ?model mm:sensorHeight ?height . }
    OPTIONAL { ?model mm:sensorShutterMode ?shutter . }
  }
  OPTIONAL {
    ?camera ssn-system:hasSystemCapability / ssn-system:hasSystemProperty ?f .

    ?f a ssn-system:Frequency ;
      qudt:numericValue ?fps .
  }
  OPTIONAL {
    ?camera ssn-system:hasSystemCapability / ssn-system:hasSystemProperty ?h .

    ?h a mm:HorizontalFieldOfView ;
      qudt:numericValue ?hfovDeg .
  }
  OPTIONAL { ?camera mm:stereoPairWith | ^ mm:stereoPairWith ?stereoPartner . }
}
ORDER BY ?device ?socket ?camera
