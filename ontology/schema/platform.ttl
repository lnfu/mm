@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sumo: <http://purl.org/ieee1872-owl/sumo-cora#> .
@prefix observable: <https://ontology.unifiedcyberontology.org/uco/observable/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix mm: <http://www.semanticweb.org/efliao/ontologies/2026/10/mm-ontology/> .

<http://www.semanticweb.org/efliao/ontologies/2026/10/mm-ontology-schema-platform> a owl:Ontology ;
    rdfs:comment "Classes and properties for the robot platform hardware."@en ;
    owl:imports <http://purl.org/ieee1872-owl/cora>, <http://purl.org/ieee1872-owl/corax>, <http://purl.org/ieee1872-owl/pos>, <http://purl.org/ieee1872-owl/rparts>, observable:1.5.0, <http://www.semanticweb.org/efliao/ontologies/2026/10/mm-ontology-schema-external-terms> .

# Classes

# TODO[lnfu] from Merge.kif (SUMO)
mm:MeasuringDevice a owl:Class ;
    rdfs:subClassOf sumo:Device ;
    rdfs:label "Measuring device"@en .

mm:EngineeringComponent a owl:Class ;
    rdfs:subClassOf sumo:Device ;
    rdfs:label "Engineering component"@en .

mm:Product a owl:Class ;
    rdfs:subClassOf sumo:Artifact ;
    rdfs:label "Product"@en .

# TODO[lnfu] from Mid-level-ontology.kif (SUMO)
mm:Computer a owl:Class ;
    rdfs:subClassOf sumo:ElectricDevice ;
    rdfs:label "Computer"@en .

mm:Camera a owl:Class ;
    rdfs:subClassOf sumo:Device ;
    rdfs:label "Camera"@en ;
    rdfs:comment "One image sensor with its lens: a single physical camera module. A stereo unit has two."@en .

# Cameras
mm:CameraDevice a owl:Class ;
    rdfs:subClassOf sumo:Device ;
    rdfs:label "Camera device"@en ;
    rdfs:comment "A unit that hosts one or more cameras and connects to a host computer, e.g. a Luxonis OAK device. Its cameras are linked with ssn:hasSubSystem."@en .

mm:ImageSensorModel a owl:Class ;
    rdfs:label "Image sensor model"@en ;
    rdfs:comment "An image sensor chip model (e.g. Sony IMX378). Holds the datasheet specs shared by every camera built on it. Property names follow GenICam SFNC."@en .

# Lens-dependent, so it belongs to a camera, not to its sensor model. Value: qudt:numericValue + qudt:hasUnit unit:DEG.
mm:FieldOfView a owl:Class ;
    rdfs:label "Field of view"@en .

mm:HorizontalFieldOfView a owl:Class ; rdfs:subClassOf mm:FieldOfView ; rdfs:label "Horizontal field of view"@en .

mm:VerticalFieldOfView a owl:Class ; rdfs:subClassOf mm:FieldOfView ; rdfs:label "Vertical field of view"@en .

mm:DiagonalFieldOfView a owl:Class ; rdfs:subClassOf mm:FieldOfView ; rdfs:label "Diagonal field of view"@en .

mm:CameraCalibration a owl:Class ;
    rdfs:label "Camera calibration"@en ;
    rdfs:comment "Intrinsic calibration of one camera at one image size. Fields follow ROS sensor_msgs/CameraInfo. Matrices are space-separated numbers in row-major order."@en .

mm:CommunicationDevice a owl:Class ;
    rdfs:subClassOf mm:EngineeringComponent ;
    rdfs:label "Communication device"@en .

mm:Microphone a owl:Class ;
    rdfs:subClassOf sumo:ElectricDevice, mm:CommunicationDevice ;
    rdfs:label "Microphone"@en .

# TODO[lnfu] from QoSontology.kif (SUMO)
mm:ComputerComponent a owl:Class ;
    rdfs:subClassOf mm:ComputerHardware ;
    rdfs:label "Computer component"@en .

mm:NetworkAdapter a owl:Class ;
    rdfs:subClassOf mm:ComputerComponent ;
    rdfs:label "Network adapter"@en .

# TODO[lnfu] duplicated declarations
mm:SpeakerDevice a owl:Class ; # ComputerInput.kif,HouseholdAppliances.kif,Mid-level-ontology.kif (SUMO)
    rdfs:subClassOf sumo:ElectricDevice ;
    rdfs:label "Speaker device"@en .

mm:ComputerHardware a owl:Class ;
    rdfs:subClassOf mm:Product ;
    rdfs:label "Computer hardware"@en . # ComputerInput.kif,QoSontology.kif (SUMO)

# Object properties
mm:connected a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain sumo:Object ;
    rdfs:range sumo:Object ;
    rdfs:label "connected"@en .

mm:stereoPairWith a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain mm:Camera ;
    rdfs:range mm:Camera ;
    rdfs:label "stereo pair with"@en .

mm:sensorModel a owl:ObjectProperty ;
    rdfs:domain mm:Camera ;
    rdfs:range mm:ImageSensorModel ;
    rdfs:label "sensor model"@en .

mm:hasCalibration a owl:ObjectProperty ;
    rdfs:domain mm:Camera ;
    rdfs:range mm:CameraCalibration ;
    rdfs:label "has calibration"@en .

mm:sensorPixelSize a owl:ObjectProperty ;
    rdfs:domain mm:ImageSensorModel ;
    rdfs:range qudt:QuantityValue ;
    rdfs:label "sensor pixel size"@en ;
    rdfs:comment "Pixel pitch of square pixels. GenICam SFNC: SensorPixelWidth / SensorPixelHeight."@en .

mm:hasFirmware a owl:ObjectProperty ;
    rdfs:range observable:Software ;
    rdfs:label "has firmware"@en ;
    rdfs:comment "Links a device to the firmware release it runs. The version lives in the firmware's observable:SoftwareFacet."@en .

# Speeds are qudt:QuantityValue nodes (qudt:numericValue + qudt:hasUnit).
# USB speed modes: HIGH (USB 2) = 480 Mbit/s, SUPER (USB 3) = 5 Gbit/s.
mm:linkSpeed a owl:ObjectProperty ; rdfs:range qudt:QuantityValue ; rdfs:label "link speed"@en .

mm:usbSpeed a owl:ObjectProperty ; rdfs:range qudt:QuantityValue ; rdfs:label "USB speed"@en .

# Datatype properties
mm:checksum a owl:DatatypeProperty ; rdfs:label "checksum"@en .

mm:boardRevision a owl:DatatypeProperty ; rdfs:label "board revision"@en .

mm:hardwareConfig a owl:DatatypeProperty ; rdfs:label "hardware config"@en .

mm:usbPath a owl:DatatypeProperty ; rdfs:label "USB path"@en .

# Image sensor specs, named after GenICam SFNC features.
mm:sensorWidth a owl:DatatypeProperty ;
    rdfs:domain mm:ImageSensorModel ; rdfs:range xsd:integer ;
    rdfs:label "sensor width"@en ;
    rdfs:comment "Effective width of the sensor in pixels. GenICam SFNC: SensorWidth."@en .

mm:sensorHeight a owl:DatatypeProperty ;
    rdfs:domain mm:ImageSensorModel ; rdfs:range xsd:integer ;
    rdfs:label "sensor height"@en ;
    rdfs:comment "Effective height of the sensor in pixels. GenICam SFNC: SensorHeight."@en .

mm:sensorShutterMode a owl:DatatypeProperty ;
    rdfs:domain mm:ImageSensorModel ; rdfs:range xsd:string ;
    rdfs:label "sensor shutter mode"@en ;
    rdfs:comment "GenICam SFNC: SensorShutterMode. Values: \"Global\", \"Rolling\", \"GlobalReset\"."@en .

# Camera calibration, named after ROS sensor_msgs/CameraInfo fields.
mm:imageWidth a owl:DatatypeProperty ;
    rdfs:domain mm:CameraCalibration ; rdfs:range xsd:integer ;
    rdfs:label "image width"@en ; rdfs:comment "CameraInfo.width, in pixels."@en .

mm:imageHeight a owl:DatatypeProperty ;
    rdfs:domain mm:CameraCalibration ; rdfs:range xsd:integer ;
    rdfs:label "image height"@en ; rdfs:comment "CameraInfo.height, in pixels."@en .

mm:distortionModel a owl:DatatypeProperty ;
    rdfs:domain mm:CameraCalibration ; rdfs:range xsd:string ;
    rdfs:label "distortion model"@en ;
    rdfs:comment "CameraInfo.distortion_model, e.g. \"plumb_bob\", \"rational_polynomial\", \"equidistant\"."@en .

mm:distortionCoefficients a owl:DatatypeProperty ;
    rdfs:domain mm:CameraCalibration ; rdfs:range xsd:string ;
    rdfs:label "distortion coefficients"@en ; rdfs:comment "CameraInfo.d. Count depends on the distortion model."@en .

mm:intrinsicMatrix a owl:DatatypeProperty ;
    rdfs:domain mm:CameraCalibration ; rdfs:range xsd:string ;
    rdfs:label "intrinsic matrix"@en ; rdfs:comment "CameraInfo.k: 3x3, 9 numbers."@en .

mm:rectificationMatrix a owl:DatatypeProperty ;
    rdfs:domain mm:CameraCalibration ; rdfs:range xsd:string ;
    rdfs:label "rectification matrix"@en ; rdfs:comment "CameraInfo.r: 3x3, 9 numbers."@en .

mm:projectionMatrix a owl:DatatypeProperty ;
    rdfs:domain mm:CameraCalibration ; rdfs:range xsd:string ;
    rdfs:label "projection matrix"@en ; rdfs:comment "CameraInfo.p: 3x4, 12 numbers."@en .

mm:boardSocket a owl:DatatypeProperty ; rdfs:label "board socket"@en .

mm:interfaceName a owl:DatatypeProperty ; rdfs:label "interface name"@en .

mm:chip a owl:DatatypeProperty ; rdfs:label "chip"@en .

mm:pciAddress a owl:DatatypeProperty ; rdfs:label "PCI address"@en .

mm:driver a owl:DatatypeProperty ; rdfs:label "driver"@en .

mm:connectionName a owl:DatatypeProperty ; rdfs:label "connection name"@en .
