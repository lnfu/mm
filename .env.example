GPU_HOST=user@10.50.80.1
ROBOT_HOST=hello-robot@10.50.100.160

# Workspace on both machines, relative to the remote home.
REMOTE_WS=mm_ws

# Gemini API key for articulate (MODE_PROMPT). `deploy.sh robot` copies this file to
